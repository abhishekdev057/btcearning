# CryptoBTC environment variables
# Copy to .env.local and fill in real values: cp .env.example .env.local
# (.env.local is gitignored — never commit real secrets)

# --- Required: read directly by the app (lib/supabase/client.ts, server.ts, proxy.ts) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Required: used to build absolute referral links (app/dashboard/referrals/page.tsx)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: overrides the Supabase email-confirmation redirect target in local dev
# (app/auth/sign-up/page.tsx). Leave unset to fall back to NEXT_PUBLIC_SITE_URL.
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL="http://localhost:3000/auth/callback"

# Required to run `npm run db:setup` (scripts/apply-db-schema.mjs applies every
# scripts/*.sql file in order via a direct Postgres connection)
POSTGRES_URL_NON_POOLING="postgres://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres"

# Required server-side only (never NEXT_PUBLIC_): used by lib/supabase/admin.ts,
# which backs app/api/offerwall/postback/route.ts to credit rewards with RLS
# bypassed. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- OfferwallApi integration — see OFFERWALLAPI_INTEGRATION.md ---
# App key for the offerwall product (Apps & Websites tab). Read server-side in
# app/dashboard/offerwall/page.tsx to build the embed URL; safe to appear in
# rendered HTML, so no NEXT_PUBLIC_ prefix is needed.
OFFERWALLAPI_API_KEY="your-offerwallapi-app-key"

# Secret key for the same app. Used only to verify the HMAC/MD5 signature on
# incoming postbacks in app/api/offerwall/postback/route.ts — never sent to
# the browser, never logged.
OFFERWALLAPI_SECRET_KEY="your-offerwallapi-secret-key"

# --- Provisioned by the Vercel Supabase integration, not read by app code ---
# Kept here because Vercel's Supabase integration creates them automatically.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SECRET_KEY="your-secret-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

POSTGRES_DATABASE="postgres"
POSTGRES_HOST="db.your-project-ref.supabase.co"
POSTGRES_PASSWORD="your-db-password"
POSTGRES_USER="postgres"
POSTGRES_URL="postgres://..."
POSTGRES_PRISMA_URL="postgres://..."
